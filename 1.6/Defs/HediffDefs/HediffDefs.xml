<HediffDef>
	<defName>VPE_Pyromancer_Emberize_STNL</defName>
	<label>Embered</label>
	<description>This creature is protected by a fiery aura rendering them immune to heat based afflictions.\n\nIt also possesses the ability to absorb nearby flames to recover from critcal wounds. Its attacks will set their targets ablaze.</description>
	<hediffClass>VPE_Pyromancer_STNL.Hediff_Emberize</hediffClass>
	<initialSeverity>1</initialSeverity>
	<minSeverity>0</minSeverity>
	<maxSeverity>1</maxSeverity>
	<!-- <lethalSeverity>1</lethalSeverity> -->
	<defaultLabelColor>(1, 0.7, 0)</defaultLabelColor>
	<makesSickThought>false</makesSickThought>
	<scenarioCanAdd>false</scenarioCanAdd>
	<isBad>false</isBad>
	<everCurableByItem>false</everCurableByItem>
	<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<alwaysAllowMothball>true</alwaysAllowMothball>
	<modExtensions>
	</modExtensions>
	<stages>
		<li>
			<statOffsets>
				<ComfyTemperatureMin>-999</ComfyTemperatureMin>
				<ComfyTemperatureMax>999</ComfyTemperatureMax>
				<ArmorRating_Heat>2</ArmorRating_Heat>
			</statOffsets>
			<statFactors>
				<Flammability>0</Flammability>
			</statFactors>
		</li>
	</stages>
	<comps>
		<li Class="HediffCompProperties_DisappearsOnDeath"/>
		<li Class="HediffCompProperties_Disappears">
			<disappearsAfterTicks>7500</disappearsAfterTicks>
			<showRemainingTime>true</showRemainingTime>
		</li>
	</comps>
</HediffDef>

