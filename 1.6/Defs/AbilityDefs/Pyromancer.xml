<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
	<defName>VPE_Pyromancer_Warmth_Ability_STNL</defName>
	<label>Warmth</label>
	<description>Produce a soothing flaming orb at the target location, this flame will steadily treat minor wounds in nearby creatures while also warming up the affected area. The temperature in the affected area cannot fall lower than 15°C.\n\nThe extreme heat emanated by this source of energy may be used to cook meals and burn certain items.</description>
	<iconPath>UI_Pyromancer_STNL/Abilities/Ability_Warmth</iconPath>
	<abilityClass>VPE_Pyromancer_STNL.Ability_Warmth</abilityClass>
	<castSound>Psycast_Skip_Entry</castSound>
	<castTime>30</castTime>
	<targetMode>Location</targetMode>
	<targetingParameters>
		<canTargetLocations>true</canTargetLocations>
		<canTargetSelf>false</canTargetSelf>
		<canTargetAnimals>false</canTargetAnimals>
		<canTargetPawns>false</canTargetPawns>
