<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<GameConditionDef>
		<defName>VPE_Pyromancer_Firestorm_Condition_STNL</defName>
		<label>Firestorm</label>
		<description>A Pyromancer is causing intense heat in the region.</description>
		<conditionClass>VPE_Pyromancer_STNL.GameCondition_Firestorm</conditionClass>
		<!-- <letterText>Unused content.</letterText> -->
		<!-- <letterDef>PositiveEvent</letterDef> -->
		<weatherDef>VPE_Firestorm_Weather_STNL</weatherDef>
		<!-- Idiots will kill themselves and blame the player -->
		<preventNeutralVisitors>true</preventNeutralVisitors>
		<preventIncidents>false</preventIncidents>
		<canAffectAllPlanetLayers>true</canAffectAllPlanetLayers>
		<canBePermanent>true</canBePermanent>
		<natural>false</natural>
		<allowUnderground>false</allowUnderground>
	</GameConditionDef>
	
	<WeatherDef>
    <defName>VPE_Firestorm_Weather_STNL</defName>
    <label>Firestorm</label>
    <description>A scorching heat is affecting the area, unroofed items and structures will periodically catch on fire.</description>
    <snowRate>0</snowRate>
    <windSpeedFactor>1.5</windSpeedFactor>
    <windSpeedOffset>1.25</windSpeedOffset>
    <accuracyMultiplier>1</accuracyMultiplier>
    <favorability>Neutral</favorability>
    <perceivePriority>1</perceivePriority>
    <rainRate>0</rainRate>
    <moveSpeedMultiplier>1</moveSpeedMultiplier>
    <preventsShuttleLaunch MayRequire="Ludeon.Rimworld.Odyssey">false</preventsShuttleLaunch>
    <overlayClasses>
      <li>WeatherOverlay_SandHard</li>
    </overlayClasses>
    <!-- Colors are Overcast -->
    <skyColorsDay>
      <sky>(0.8,0.5,0.5)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(1,0.0,0.0)</overlay>
      <saturation>1</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(1,0.6,0.6)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(1,0.0,0.0)</overlay>
      <saturation>1</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.35,0.0,0.0)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(1,0.0,0.0)</overlay>
      <saturation>1</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.35,0.10,0.10)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(1,0.0,0.0)</overlay>
      <saturation>1</saturation>
    </skyColorsNightMid>
  </WeatherDef>
</Defs>
